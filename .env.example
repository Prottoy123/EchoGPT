# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://echogpt:echogpt_secret@localhost:5433/echogpt_db?schema=public

# JWT Authentication
JWT_ACCESS_SECRET=echogpt_super_secret_jwt_access_key_min_32_characters_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=echogpt_super_secret_jwt_refresh_key_min_32_characters_67890
JWT_REFRESH_EXPIRES_IN=7d

# Cryptography / Security
# 32-byte (64 hex characters) key for AES-256-GCM encrypted API key vaulting
ENCRYPTION_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Seed Admin Credentials
ADMIN_EMAIL=admin@echogpt.com
ADMIN_PASSWORD=AdminPass123!
