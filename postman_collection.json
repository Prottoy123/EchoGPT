{
  "info": {
    "_postman_id": "echogpt-backend-lean-collection",
    "name": "EchoGPT Backend REST API (Lean MVP)",
    "description": "Production REST API Collection for EchoGPT Chrome Extension Backend (NestJS + PostgreSQL + Vercel AI SDK + Swagger)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User (Auto Free Plan)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@echogpt.com\",\n  \"password\": \"UserSecretPass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Rotate Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          }
        }
      ]
    },
    {
      "name": "2. User Profile & Usage",
      "item": [
        {
          "name": "Get Profile & Remaining Quota",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        }
      ]
    },
    {
      "name": "3. AI Providers (Admin Only)",
      "item": [
        {
          "name": "List Providers (Masked Keys)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/ai-providers", "host": ["{{baseUrl}}"], "path": ["ai-providers"] }
          }
        },
        {
          "name": "Register Provider (AES-256-GCM Encrypted)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"OPENAI\",\n  \"apiKey\": \"sk-proj-sample-api-key-here\",\n  \"isDefault\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/ai-providers", "host": ["{{baseUrl}}"], "path": ["ai-providers"] }
          }
        },
        {
          "name": "Set Default Provider",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/ai-providers/:id/default", "host": ["{{baseUrl}}"], "path": ["ai-providers", ":id", "default"], "variable": [{"key": "id", "value": ""}] }
          }
        }
      ]
    },
    {
      "name": "4. Chat Engine (Vercel AI SDK)",
      "item": [
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Explain the benefits of clean architecture in two sentences.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/chat/message", "host": ["{{baseUrl}}"], "path": ["chat", "message"] }
          }
        },
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/chat/conversations?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["chat", "conversations"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "20"}] }
          }
        },
        {
          "name": "Get Conversation History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/chat/conversations/:id", "host": ["{{baseUrl}}"], "path": ["chat", "conversations", ":id"], "variable": [{"key": "id", "value": ""}] }
          }
        },
        {
          "name": "Delete Conversation",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/chat/conversations/:id", "host": ["{{baseUrl}}"], "path": ["chat", "conversations", ":id"], "variable": [{"key": "id", "value": ""}] }
          }
        }
      ]
    },
    {
      "name": "5. Web Search",
      "item": [
        {
          "name": "Execute Web Search",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"NestJS OpenAPI best practices\",\n  \"maxResults\": 5\n}"
            },
            "url": { "raw": "{{baseUrl}}/search/query", "host": ["{{baseUrl}}"], "path": ["search", "query"] }
          }
        },
        {
          "name": "Get Search History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/search/history?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["search", "history"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "20"}] }
          }
        },
        {
          "name": "Get Recent Searches",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/search/recent?limit=5", "host": ["{{baseUrl}}"], "path": ["search", "recent"], "query": [{"key": "limit", "value": "5"}] }
          }
        }
      ]
    }
  ]
}
